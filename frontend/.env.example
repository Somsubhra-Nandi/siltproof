# Copy to frontend/.env (git-ignored). Never commit real keys.
VITE_AWS_REGION=ap-south-1

# Amazon Location API key, created manually (see README manual steps).
VITE_LOCATION_API_KEY=replace-me

# Placeholder ward centre: Mithi river, Mumbai. Change once the ward is picked.
VITE_MAP_CENTER_LAT=19.0760
VITE_MAP_CENTER_LON=72.8777
VITE_MAP_ZOOM=13

# ApiUrl output from `sam deploy`.
VITE_API_BASE_URL=http://127.0.0.1:3000
