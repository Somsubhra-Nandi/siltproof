# Copy to frontend/.env (git-ignored). Never commit real keys.
VITE_AWS_REGION=ap-south-1

# Amazon Location API key, created manually (docs/amazon-location.md).
# Leave it as replace-me, or empty, to use the bundled offline map.
VITE_LOCATION_API_KEY=replace-me

# Maps v2 style and colour scheme. Monochrome Light is the survey-sheet base.
VITE_LOCATION_MAP_STYLE=Monochrome
VITE_LOCATION_COLOR_SCHEME=Light

# Placeholder ward centre: Mithi river, Mumbai. Change once the ward is picked.
VITE_MAP_CENTER_LAT=19.0760
VITE_MAP_CENTER_LON=72.8777
VITE_MAP_ZOOM=13

# ApiUrl output from `sam deploy`. The judge trial (trial.html) always uses it.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Where the 18-drain investigation comes from: snapshot (the committed,
# simulated public/data/demo; decisions stay in the browser) or api (the live
# bill). Unset means api when VITE_API_BASE_URL is set.
VITE_BILL_SOURCE=snapshot
